#!/bin/sh
# Turn fenced code blocks on stdin into published tj resources.
#
# An agent writes ordinary markdown - it is good at that and needs no
# instructions - and the fenced blocks become addressable files of the
# interaction. Nothing is asked of the model, which will not emit terminal
# control sequences anyway, and rightly refuses when asked to.
#
#   cl() { claude -p "$*" | tj-fence; }
#
# The display is unchanged: the markers wrap the block's contents, and the
# fence lines are printed as they were.
exec awk '
function mime(lang) {
  if (lang == "csv")  return "text/csv"
  if (lang == "json") return "application/json"
  if (lang == "sh" || lang == "bash" || lang == "zsh") return "text/x-shellscript"
  if (lang == "py" || lang == "python") return "text/x-python"
  if (lang == "zig")  return "text/x-zig"
  if (lang == "sql")  return "application/sql"
  return "text/plain"
}
/^```/ {
  if (inblock) {
    printf "\033]5107;tj;end\033\\"
    print
    inblock = 0
    next
  }
  lang = $0
  sub(/^```[ \t]*/, "", lang)
  sub(/[ \t].*$/, "", lang)
  n++
  ext = (lang == "" ? "txt" : lang)
  print
  printf "\033]5107;tj;begin;files/%d.%s;%s\033\\", n, ext, mime(lang)
  inblock = 1
  next
}
{ print }
END { if (inblock) printf "\033]5107;tj;end\033\\" }
'
