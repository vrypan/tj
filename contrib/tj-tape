#!/bin/sh
# Emit a vhs tape that records `tjctl replay`.
#
#   tj-tape <journal> [output.gif] [replay flags...] > demo.tape
#   vhs demo.tape
#
# The tape plays a recording rather than re-running anything, so the GIF shows
# the output that was actually captured. A tape that re-ran the commands would
# be a different thing entirely, and would cheerfully re-run whatever `rm -rf`
# was in the journal.
#
# Flags after the output file go to `tjctl replay`, so pacing is tuned there:
#
#   tj-tape 01abc demo.gif --speed 2 --from 4 --to 9 > demo.tape
set -eu

journal=${1:-}
[ -n "$journal" ] || {
  echo "usage: tj-tape <journal> [output.gif] [replay flags...]" >&2
  exit 2
}
shift

output=demo.gif
case "${1:-}" in
  *.gif | *.mp4 | *.webm) output=$1; shift ;;
esac

# vhs has no way to wait for a process to exit, so the tape has to know how
# long the replay runs. Ask the replay itself rather than guessing.
seconds=$(tjctl replay "$journal" --duration "$@")

cat <<TAPE
# Generated by tj-tape. Plays a recorded journal; nothing is re-executed.
Require tj

Output $output

Set FontSize 16
Set Width 1200
Set Height 700
Set Padding 20
Set WindowBar Colorful
Set BorderRadius 8

# The replay does its own typing, at its own pace.
Set TypingSpeed 1ms

Sleep 500ms
Type "tjctl replay $journal $*"
Enter
Sleep $((seconds + 2))s
TAPE
